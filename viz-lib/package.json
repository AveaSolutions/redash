{
  "name": "@redash/viz",
  "version": "1.0.0",
  "description": "Redash visualizations",
  "main": "lib/index.js",
  "scripts": {
    "clean": "rm -rf lib dist",
    "type-check": "tsc --noEmit",
    "type-gen": "tsc --emitDeclarationOnly",
    "build:babel:base": "babel src --out-dir lib --source-maps --ignore 'src/**/*.test.js' --ignore 'src/**/*.test.tsx' --ignore 'src/testing/**' --copy-files --no-copy-ignored --extensions .ts,.tsx,.js,.jsx",
    "build:babel": "npm run type-gen && npm run build:babel:base",
    "build": "NODE_ENV=production run-s clean build:babel",
    "watch:babel": "npm run build:babel:base -- --watch",
    "watch": "npm run watch:babel",
    "version": "npm run build",
    "preinstall": "node -e \"if (require('fs').existsSync('package-lock.json')) require('child_process').execSync('npx npm-force-resolutions', {stdio:'inherit'})\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "author": "Avea Solutions",
  "license": "BSD-2-Clause",
  "private": true,
  "peerDependencies": {
    "antd": ">=4.0.0",
    "@ant-design/icons": ">=4.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.10",
    "@types/chroma-js": "^2.1.2",
    "@types/d3": "^6.2.0",
    "@types/d3-cloud": "^1.2.3",
    "@types/debug": "^4.1.5",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^28.1.8",
    "@types/leaflet": "^1.5.19",
    "@types/numeral": "0.0.28",
    "@types/plotly.js": "^2.35.2",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/tinycolor2": "^1.4.2",
    "babel-jest": "^28.1.3",
    "babel-plugin-istanbul": "^8.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "form-data": "^4.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "minimatch": "^9.0.5",
    "brace-expansion": "^2.0.2",
    "minimist": "^1.2.8",
    "mockdate": "^2.0.5",
    "npm-run-all2": "^9.0.2",
    "npm-force-resolutions": "^0.0.10",
    "path-parse": "^1.0.7",
    "prop-types": "^15.7.2",
    "semver": "^7.8.5",
    "shell-quote": "^1.10.0",
    "typescript": "^4.1.2"
  },
  "resolutions": {
    "js-yaml": "3.15.0",
    "json5": "2.2.3"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "axios": "0.33.0",
    "beautifymarker": "^1.0.7",
    "chroma-js": "^1.3.6",
    "classnames": "^2.2.6",
    "d3": "^3.5.17",
    "d3-cloud": "^1.2.4",
    "debug": "^3.2.7",
    "dompurify": "^3.4.11",
    "font-awesome": "^4.7.0",
    "hoist-non-react-statics": "^3.3.0",
    "leaflet": "^1.2.0",
    "leaflet-fullscreen": "^1.0.2",
    "leaflet.markercluster": "^1.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "numeral": "^2.0.6",
    "plotly.js": "^3.7.0",
    "react-pivottable": "^0.9.0",
    "react-sortable-hoc": "^1.10.1",
    "tinycolor2": "^1.4.1",
    "use-debounce": "^3.4.1",
    "use-media": "^1.4.0"
  },
  "jest": {
    "rootDir": "./src",
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "../__tests__/rtl_setup.js",
      "../__tests__/mocks.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)": "<rootDir>/$1",
      "\\.(css|less)$": "identity-obj-proxy"
    }
  }
}
